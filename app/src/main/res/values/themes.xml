<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bungae" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F6F3EE</item>
        <item name="android:colorBackground">#F6F3EE</item>
    </style>

    <style name="Theme.Bungae.Alarm" parent="Theme.Bungae">
        <item name="android:windowBackground">#8E1218</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
