<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bungae" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorPrimary">#FF0B57D0</item>
        <item name="android:colorPrimaryDark">#FF0842A0</item>
        <item name="android:colorAccent">#FF0B57D0</item>
        <item name="android:windowBackground">#FFF2F4F6</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="Theme.Bungae.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#FFC4161E</item>
        <item name="android:colorAccent">#FFC4161E</item>
        <item name="android:windowBackground">#FFC4161E</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
